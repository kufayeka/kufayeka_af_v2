{
  "udp": {
    "host": "0.0.0.0",
    "port": 9900
  },
  "http": {
    "host": "0.0.0.0",
    "port": 8080,
    "maxPoints": 100000,
    "streamThresholdPoints": 5000
  },
  "storage": {
    "dataDir": "./data",
    "shardCount": 16,
    "partitionDurationMs": 86400000,
    "timestampUnit": "us"
  },
  "flush": {
    "flushIntervalMs": 100,
    "flushBytes": 262144,
    "maxQueuePoints": 200000,
    "backpressurePolicy": "drop_new"
  },
  "index": {
    "indexBlockOnFlush": true,
    "enablePerTagSparseIndex": false,
    "indexStridePerTag": 4096
  },
  "retention": {
    "enabled": false,
    "maxAgeHours": 168,
    "checkIntervalMs": 300000
  },
  "query": {
    "maxParallel": 6,
    "scanChunkBytes": 524288,
    "fdCacheEnabled": true,
    "fdCacheMaxOpen": 256,
    "fdCacheIdleMs": 5000
  },
  "fsync": {
    "walPolicy": "interval",
    "walIntervalMs": 200,
    "segmentPolicy": "interval",
    "segmentIntervalMs": 500
  }
}