{
  "udp": {
    "host": "0.0.0.0",
    "port": 9900
  },
  "http": {
    "host": "0.0.0.0",
    "port": 8080,
    "maxPoints": 100000,
    "maxRangeMs": 86400000,
    "streamThresholdPoints": 5000
  },
  "storage": {
    "dataDir": "./data",
    "shardCount": 16,
    "partitionDurationMs": 3600000,
    "timestampUnit": "us"
  },
  "flush": {
    "flushIntervalMs": 5,
    "flushBytes": 262144,
    "maxQueuePoints": 200000,
    "backpressurePolicy": "drop_new"
  },
  "index": {
    "indexBlockOnFlush": true,
    "enablePerTagSparseIndex": false,
    "indexStridePerTag": 4096
  },
  "retention": {
    "enabled": false,
    "maxAgeHours": 168,
    "checkIntervalMs": 300000
  },
  "workers": {
    "poolSize": 0,
    "maxPoolSize": 8,
    "jobTimeoutMs": 15000,
    "offloadMinRangeMs": 7200000,
    "offloadMinLimit": 5000
  }
}