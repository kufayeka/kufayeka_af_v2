{
  "name": "file-timeseries-historian",
  "version": "0.1.0",
  "private": true,
  "description": "MVP file-based industrial-style historian in Node.js + TypeScript",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "send:udp": "tsx scripts/udp_sender.ts",
    "query:examples": "tsx scripts/query_examples.ts",
    "bench": "tsx scripts/benchmark.ts"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
