    {
      "id": "Taiyo1.PLC.PaperLengthCounter",
      "label": "",
      "type": "script",
      "enabled": true,
      "allowTreeDuplicate": true,
      "description": "",
      "script": "const raw = Number(EncoderRawValue?.value || 0);\r\nconst paperPath = PaperLength?.path || \"\";\r\nconst prevRawPath = EncoderPrevRaw?.path || \"\";\r\n\r\nif (!paperPath || !prevRawPath) {\r\n  send(msg);\r\n  return;\r\n}\r\n\r\nconst prevRaw = Number(EncoderPrevRaw?.value || 0);\r\n\r\n// naik normal -> delta selisih\r\n// turun/reset -> delta = raw (anggap restart dari 0, tapi mungkin kebaca telat dan langsung lompat)\r\nconst delta = raw >= prevRaw ? (raw - prevRaw) : raw;\r\n\r\nconst total = Number(PaperLength?.value || 0) + delta;\r\n\r\nasset.set(paperPath, total);\r\nasset.set(prevRawPath, raw);\r\n\r\nsend(msg);\r\n",
