      "enabled": true,
      "description": "",
      "script": "// VARIABLE BINDINGS\r\nconst jobLifecycleAttribute = JobLifecycleAttribute?.value || \"-\";\r\nconst workOrderAttribute = WorkOrderAttribute?.value || \"-\";\r\nconst operatorAttribute = OperatorAttribute?.value || \"-\";\r\nconst timestamp = Timestamp?.value || helpers.now();\r\nconst assetPath = AssetPath || \"-\";\r\nconst alarmAttributePath = AlarmAttribute?.path || \"-\";\r\nconst jobLifecycleAttributePath = JobLifecycleAttribute?.path || \"-\";\r\nconst workOrderAttributePath = WorkOrderAttribute?.path || \"-\";\r\n\r\n// GET ACTIVE JOB LOAD EVENTS => Jasuindo.Taiyo1/Job/*/Lifecycle/Running\r\nconst openedEvents = eventSys.get(`${ assetPath }/Job/${ workOrderAttribute }/Lifecycle/Running`, \"*\", \"*\", \"open\", {}, { limit: 1 });\r\n\r\n// TEMPLATE EVENT PATH\r\nconst eventLifecyclePath = `${ assetPath }/Job/${ workOrderAttribute }/Lifecycle/`;\r\nconst eventActivityPath = `${assetPath}/Job/${workOrderAttribute}/Activity/*`;\r\n\r\n// REJECT IF WORK ORDER IS EMPTY / \"-\" AND RAISE ALARM\r\nif (workOrderAttribute === \"-\" || workOrderAttribute === \"\" || workOrderAttribute === null) {\r\n\r\n  asset.set(alarmAttributePath, `!!!Work order is empty!!!`);\r\n  asset.set(jobLifecycleAttributePath, `-`);\r\n  send(msg);\r\n\r\n} else {\r\n\r\n  asset.set(alarmAttributePath, `-`);\r\n\r\n  // CREATE EVENT BASED ON LIFECYCLE\r\n  if (jobLifecycleAttribute === \"load\") {\r\n\r\n    if (openedEvents.length === 0) {\r\n\r\n      const jobLifecycleContext = {\r\n        operator: operatorAttribute,\r\n        workOrder: workOrderAttribute,\r\n      }\r\n\r\n      eventSys.open(`${eventLifecyclePath}Running`, timestamp, jobLifecycleContext, `${workOrderAttribute} loaded`, \"info\");\r\n\r\n    }\r\n\r\n  } else if (jobLifecycleAttribute === \"unload\") {\r\n\r\n    if (openedEvents.length > 0) {\r\n\r\n      eventSys.close(`${eventLifecyclePath}Running`, timestamp, `${workOrderAttribute} unloaded`);\r\n      eventSys.close(`${eventActivityPath}`, timestamp, `${workOrderAttribute} unloaded`);\r\n\r\n      asset.set(workOrderAttributePath, `-`);\r\n\r\n    }\r\n\r\n  }\r\n\r\n\r\n}\r\n\r\n\r\n\r\nsend(msg);",
