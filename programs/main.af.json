    {
      "id": "template.script_1772002036179",
      "name": "TaiyoJobActivityEvent",
      "description": "",
      "script": "// VARIABLE BINDINGS\r\nconst jobActivityAttribute = JobActivityAttribute?.value || \"-\";\r\nconst jobActivityAttributePath = JobActivityAttribute?.path || \"-\";\r\nconst workOrderAttribute = WorkOrderAttribute?.value || \"-\";\r\nconst operatorAttribute = OperatorAttribute?.value || \"-\";\r\nconst timestamp = Timestamp?.value || helpers.now();\r\nconst assetPath = AssetPath || \"-\";\r\nconst alarmAttributePath = AlarmAttribute?.path || \"-\";\r\n\r\n// STOP jika reset / invalid (jangan bikin event)\r\nif (jobActivityAttribute === \"-\" || jobActivityAttribute === \"\" || jobActivityAttribute === null) {\r\n  send(msg);\r\n  return;\r\n}\r\n\r\n// STOP jika wo not found (jangan bikin event)\r\nif (workOrderAttribute === \"-\" || workOrderAttribute === \"\" || workOrderAttribute === null) {\r\n  asset.set(alarmAttributePath, \"!!!No Active Work Order!!!\");\r\n  send(msg);\r\n  return;\r\n}\r\n\r\nconst eventPath = `${assetPath}/Job/${workOrderAttribute}/Activity/${jobActivityAttribute}`;\r\nconst openedEvents = eventSys.get(eventPath, \"*\", \"*\", \"open\", {}, { limit: 1 });\r\n\r\nif (openedEvents.length > 0) {\r\n  asset.set(alarmAttributePath, `!!!Activity already open: ${jobActivityAttribute}!!!`);\r\n  send(msg);\r\n  return;\r\n}\r\n\r\nasset.set(alarmAttributePath, \"-\");\r\n\r\nconst activityContext = {\r\n  operator: operatorAttribute,\r\n  workOrder: workOrderAttribute,\r\n};\r\n\r\neventSys.open(eventPath, timestamp, activityContext, `activity ${jobActivityAttribute} created`, \"info\");\r\n\r\n// AUTO RESET activity biar bisa trigger lagi walau value sama\r\nasset.set(jobActivityAttributePath, \"-\");\r\n\r\nsend(msg);\r\n",
