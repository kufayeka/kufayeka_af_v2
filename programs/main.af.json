    {
      "id": "Taiyo1.Alarms.machineSpeed",
      "label": "",
      "type": "script",
      "enabled": true,
      "description": "",
      "script": "const nowTs = msg.ts || helpers.now();\n\nconst eventPath = `${MachineAlarmAttribute.path}/Event/Alarm/MachineSpeedHigh`;\nconst speed = Number(MachinePresentValue?.value ?? 0);\nconst threshold = Number(Threshold ?? 0);\nconst operatorLabel = OperatorName?.value?.label ?? \"-\";\n\nconst openRows = eventSys.get(`${eventPath}*`, \"*\", \"*\", \"open\", {}, { limit: 1 });\n\nif (speed > threshold) {\n\n  asset.set(MachineAlarmAttribute.path, `Oii ${operatorLabel} bahaya!`);\n\n  if (openRows.length === 0) {\n    eventSys.open(eventPath,nowTs,{operatorLabel,speed,threshold},`Machine speed ${speed} > threshold ${threshold}`,\"low\");\n  }\n\n} else {\n\n  asset.set(MachineAlarmAttribute.path, \"No alarm.\");\n\n  if (openRows.length > 0) {\n    eventSys.close(`${eventPath}*`,nowTs,`Machine speed ${speed} <= threshold ${threshold}`);\n  }\n}\n\nsend(msg);",
      "templateId": "template.script_1771609498627",
      "templateBindingOverrides": {
